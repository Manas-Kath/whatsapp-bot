# Bunty v5.6 Environment Configuration

# Gemini API Key (Required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Bot Prefix (Default: .)
BOT_PREFIX=.

# Super Admin WhatsApp JID / LID (comma separated)
SUPER_ADMIN_IDS=27441082949745@lid

# MQTT Broker URL for IoT Hardware (ESPHome/Mosquitto)
# Example local Mosquitto IP or hostname on Debian home server
MQTT_BROKER_URL=mqtt://192.168.1.90:1883

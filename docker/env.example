# Bunty v5.6 Environment Configuration

# Gemini API Key (Required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Bot Prefix (Default: .)
BOT_PREFIX=.

# Super Admin WhatsApp JID / LID (comma separated)
SUPER_ADMIN_IDS=27441082949745@lid

# MQTT Broker URL for IoT Hardware (ESPHome/Mosquitto)
# Example local Mosquitto IP or hostname on Debian home server
MQTT_BROKER_URL=mqtt://192.168.1.90:1883

# Group Add (.groupadd) - optional tuning
# Country code prepended to bare 10-digit numbers
DEFAULT_COUNTRY_CODE=91
# Max numbers per command, numbers processed per run (rest queued for .groupadd resume),
# and randomized delay (ms) between adds
GROUPADD_MAX=500
GROUPADD_BATCH=30
# Numbers sent per add request (like the official app); 1 = one request per number
GROUPADD_CHUNK=5
GROUPADD_MIN_DELAY=8000
GROUPADD_MAX_DELAY=15000
